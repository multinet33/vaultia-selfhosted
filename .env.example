# Configuration de Vaultia auto-hébergé (compose.yaml). Détail : docs/configuration.md.
#
#     cp .env.example .env
#
# puis remplir chaque valeur vide de la section OBLIGATOIRE (commande de génération indiquée au-dessus
# de la ligne) : tant qu'une valeur obligatoire manque, `docker compose up` refuse de démarrer.
# .env contient des secrets : ne jamais le publier, le sauvegarder à part (docs/backup-restore.md).
# Sur Linux : chmod 600 .env
#
# Guides pas à pas : docs/docker.md (ligne de commande), docs/portainer.md (Portainer).

# =================================================================================================
# OBLIGATOIRE
# =================================================================================================

# Mot de passe de PostgreSQL (hexadécimal : aucun caractère à échapper).     openssl rand -hex 24
POSTGRES_PASSWORD=

# Signature des sessions ; au moins 32 caractères.                          openssl rand -base64 32
# Le perdre ou le changer déconnecte tout le monde et invalide les liens de partage.
BETTER_AUTH_SECRET=

# Adresse exacte ouverte dans le navigateur (schéma + hôte + port, sans chemin). Trois formes :
#   http://localhost:3000             la machine elle-même (aussi 127.0.0.1)
#   http://<IPv4 privée>:<port>       réseau local SEULEMENT : 10.x.x.x, 172.16-31.x.x, 192.168.x.x,
#                                     par exemple http://192.168.1.100:6080 (adresse à remplacer ;
#                                     éviter le port 6000, refusé par les navigateurs Chromium) ;
#                                     sans chiffrement, ni mode hors ligne ni caméra du scanner ;
#                                     VAULTIA_BIND_ADDRESS = cette adresse (docs/configuration.md)
#   https://vaultia.home.arpa         HTTPS local avec Caddy (docs/https.md), ou derrière votre
#                                     reverse proxy HTTPS (docs/reverse-proxy.md) : recommandé,
#                                     toutes les fonctions disponibles
# Tout autre http (nom d'hôte, adresse publique) est refusé au démarrage : HTTPS obligatoire.
BETTER_AUTH_URL=http://localhost:3000

# =================================================================================================
# FACULTATIF
# =================================================================================================

# Qui peut créer un compte (distinct de l'invitation à un Espace) :
#   first-user (défaut) : le premier compte librement (l'administrateur), ensuite seulement avec une
#                         invitation valide ;
#   invite              : uniquement avec une invitation valide ;
#   open                : inscription publique — à ne choisir que délibérément.
VAULTIA_SIGNUP_POLICY=first-user

# Adresse et port de l'hôte où Vaultia est publié. 127.0.0.1 : la machine elle-même, ou un reverse
# proxy installé sur elle. En HTTP sur le réseau local : l'adresse IPv4 privée du serveur, celle de
# BETTER_AUTH_URL. Ne jamais publier sur 0.0.0.0 sans HTTPS devant, ni rediriger ce port depuis la box.
VAULTIA_BIND_ADDRESS=127.0.0.1
VAULTIA_PORT=3000

# Derrière un reverse proxy : son adresse IP (ou plage CIDR) telle que Vaultia la voit, pour lire
# l'adresse réelle des visiteurs. Jamais 0.0.0.0/0. Vide : aucun proxy de confiance.
#   proxy sur l'hôte, qui joint 127.0.0.1:3000    : l'adresse de la passerelle du réseau Docker,
#                                                   172.30.83.1 avec le sous-réseau par défaut
#   proxy en conteneur dans le réseau `vaultia`    : son adresse fixe (ex. 172.30.83.10)
TRUSTED_PROXIES=

# HSTS en secondes (HTTPS seulement), ex. 31536000 = un an. Vide : aucun en-tête HSTS.
HSTS_MAX_AGE=

# =================================================================================================
# HTTPS LOCAL (facultatif) — Caddy et son autorité locale, sans domaine ni Internet : docs/https.md
# =================================================================================================

# Décommenter les trois lignes, adapter le nom, et modifier plus haut, dans leurs lignes :
#   BETTER_AUTH_URL=https://vaultia.home.arpa   (même nom ; ajouter :port si ce n'est pas 443)
#   TRUSTED_PROXIES=172.30.83.10                (adresse de Caddy ci-dessous)
#   VAULTIA_BIND_ADDRESS=<IPv4 privée du serveur> (Caddy y publie le port HTTPS)
# puis `docker compose up -d`.
# Pile Portainer : COMPOSE_FILE y est sans effet (Portainer impose son Compose path) ; choisir le
# Compose path compose.portainer-https.yaml à la place (docs/portainer.md § 13).
# COMPOSE_FILE=compose.yaml:compose.https.yaml
# VAULTIA_DOMAIN=vaultia.home.arpa
# CADDY_HTTPS_PORT=443
# Adresse fixe de Caddy dans le réseau interne (celle de TRUSTED_PROXIES), à changer seulement avec
# VAULTIA_SUBNET.
# CADDY_IPV4_ADDRESS=172.30.83.10

# =================================================================================================
# AVANCÉ — les valeurs par défaut conviennent
# =================================================================================================

# Image de Vaultia. Vide : l'image candidate épinglée dans compose.yaml (recommandé).
# Facultatif : canal de mise à jour automatique, pour un Watchtower (ou autre outil de mise à jour
# d'images). Un seul canal ; les deux sont indépendants, jamais `latest`.
#   candidats (release candidates) :
# VAULTIA_IMAGE=ghcr.io/multinet33/vaultia:rc
#   versions stables (canal pas encore publié pendant la bêta) :
# VAULTIA_IMAGE=ghcr.io/multinet33/vaultia:stable
# Le défaut reste l'image immuable épinglée dans compose.yaml. Un canal mobile échange cet
# épinglage reproductible contre des mises à jour automatiques, migrations de base comprises :
# lire d'abord docs/update.md (« Mises à jour automatiques »).
VAULTIA_IMAGE=

# Base PostgreSQL (nom d'utilisateur et de base). Ne pas changer après la première installation.
POSTGRES_USER=vaultia
POSTGRES_DB=vaultia

# Sous-réseau interne des conteneurs, à changer seulement en cas de conflit avec un réseau existant.
VAULTIA_SUBNET=172.30.83.0/24

# Moteurs d'analyse installés. Vide : liste par défaut
# (zxing-barcode,tesseract-ocr,siglip2-vision,e5-embeddings,document-rules,open-facts) :
#   zxing-barcode, tesseract-ocr, document-rules   inclus dans l'image, sans réseau
#   siglip2-vision                                  modèle (90 Mio) installé au premier démarrage
#   e5-embeddings                                   recherche par le sens : modèle (130 Mio) installé
#                                                   au premier démarrage
#   open-facts                                      EXTERNE (Internet) : présent ne veut pas dire
#                                                   appelé — seulement pour un Espace en mode
#                                                   « externe » ; jamais en mode local
# Installé ne veut pas dire autorisé : chaque Espace reste « désactivé » tant qu'il n'en décide pas.
# Pour installer moins de moteurs, donner une liste réduite, ex. zxing-barcode,tesseract-ocr,document-rules
INTELLIGENCE_PROVIDERS=

# Installation automatique du modèle de la vision locale au démarrage : auto (défaut) ou off.
INTELLIGENCE_MODELS_PROVISION=

# Contact ajouté aux requêtes vers les bases produit ouvertes (seulement avec open-facts).
INTELLIGENCE_CONTACT=

# --- Recherche Web de codes produit (FACULTATIVE, désactivée par défaut) ------------------------
# Quand ni l'inventaire ni les bases produit ouvertes ne connaissent un EAN/UPC, Vaultia peut
# chercher le code exact sur le Web et proposer une fiche sourcée (docs/web-product-search.md).
# Traitement EXTERNE : seulement pour un Espace en mode « externe », jamais en mode local.
# Pour l'activer :
#   1. ajouter web-product-search à la FIN de INTELLIGENCE_PROVIDERS (après open-facts), en gardant
#      les moteurs déjà listés — liste complète par défaut :
#      zxing-barcode,tesseract-ocr,siglip2-vision,e5-embeddings,document-rules,open-facts,web-product-search
#   2. choisir un moteur :
#      a) SearXNG auto-hébergé (recommandé, sans clé) : COMPOSE_PROFILES=web-search,
#         WEB_PRODUCT_SEARCH_BACKEND=searxng, WEB_PRODUCT_SEARCH_URL=http://172.30.83.11:8080
#         et SEARXNG_SECRET (openssl rand -hex 32) ;
#      b) API Brave Search (service distant, clé requise, aucun conteneur en plus) :
#         WEB_PRODUCT_SEARCH_BACKEND=brave et WEB_PRODUCT_SEARCH_API_KEY.
# Tout vide : Vaultia fonctionne exactement comme sans cette fonction.
# Démarre le conteneur SearXNG (web-search) ; vide : aucun conteneur en plus.
COMPOSE_PROFILES=
# searxng ou brave ; vide : recherche Web non configurée.
WEB_PRODUCT_SEARCH_BACKEND=
# SearXNG : son adresse interne (IPv4 fixe, voir SEARXNG_IPV4_ADDRESS ; Vaultia n'accepte en http
# qu'une IPv4 privée). Vide avec brave.
WEB_PRODUCT_SEARCH_URL=
# Brave : clé de l'API Brave Search. SECRET — jamais dans Git. Vide avec searxng.
WEB_PRODUCT_SEARCH_API_KEY=
# SearXNG : secret de l'instance (openssl rand -hex 32). SECRET. Sans lui, SearXNG refuse de démarrer.
SEARXNG_SECRET=
# SearXNG : adresse fixe dans VAULTIA_SUBNET. Vide : 172.30.83.11 (à changer avec VAULTIA_SUBNET).
SEARXNG_IPV4_ADDRESS=

# Lecture du texte des documents (recherche dans le contenu) : inline (défaut) ou off.
DOCUMENT_INDEXER=

# Langues de la reconnaissance de texte (Tesseract), jointes par +. Vide : fra+eng (les seules
# langues présentes dans l'image).
TESSERACT_LANGS=

# Taille maximale d'un fichier envoyé, en octets (1000 à 50000000). Vide : 10000000.
MEDIA_MAX_UPLOAD_BYTES=

# Tâche planifiée externe des notifications (POST /api/notifications/refresh). Vide : désactivée,
# les notifications sont recalculées à l'ouverture.                      openssl rand -hex 32
NOTIFICATIONS_CRON_SECRET=

# Webhooks sortants vers le réseau local (Home Assistant, n8n…) : true pour les autoriser.
WEBHOOK_ALLOW_PRIVATE_NETWORKS=
# Clé des secrets de webhooks (32 caractères au moins). Vide : dérivée de BETTER_AUTH_SECRET.
WEBHOOK_SECRET_KEY=
